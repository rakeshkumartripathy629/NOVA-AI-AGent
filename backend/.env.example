# ============================================================
# Nova AI — Environment Configuration
# Copy this to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# Security — generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON
CSRF_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nova_ai

# AI Providers (get free keys)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Nova AI

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback/github

# Redis (for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO/S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=nova-ai
STORAGE_AUTO_FALLBACK=true

# Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
