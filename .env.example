# Nova AI — environment configuration
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# Never commit the real .env file.

# Application
ENVIRONMENT=production
DEBUG=false
# IMPORTANT: set your own long random string (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string
FIRST_SUPERUSER_EMAIL=admin@nova-ai.com
FIRST_SUPERUSER_PASSWORD=change-me-please
FIRST_SUPERUSER_USERNAME=admin

# AI — Google Gemini (free tier)
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=1536

# Email (Gmail example — use an App Password from your Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-gmail@gmail.com
EMAIL_FROM_NAME=Nova AI

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
