# Nova AI — environment configuration
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# Never commit the real .env file.

# Application
ENVIRONMENT=production
DEBUG=false
# IMPORTANT: set your own long random string (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string
FIRST_SUPERUSER_EMAIL=admin@nova-ai.com
FIRST_SUPERUSER_PASSWORD=change-me-please
FIRST_SUPERUSER_USERNAME=admin

# AI — Google Gemini (free tier)
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=1536

# AI — Groq (free tier, no credit card)
# Get your key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Local embeddings (free, no API key) — used when no API embedding provider is set
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIMENSION=384

# Long-term memory (assistant remembers facts across conversations)
# MEMORY_EMBEDDING_PROVIDER: auto | gemini | openai | local
MEMORY_EMBEDDING_PROVIDER=auto
# MEMORY_VECTOR_STORE: auto | qdrant | postgres
MEMORY_VECTOR_STORE=auto
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACT=true
MEMORY_RECALL_LIMIT=8
MEMORY_TOKEN_LIMIT=1200
MEMORY_RELEVANCE_THRESHOLD=0.25
MEMORY_WEIGHT_SIMILARITY=0.60
MEMORY_WEIGHT_IMPORTANCE=0.15
MEMORY_WEIGHT_RECENCY=0.15
MEMORY_WEIGHT_CONFIDENCE=0.10
MEMORY_EXTRACTION_MODEL=
MEMORY_EXTRACTION_MIN_MESSAGE_LEN=20
MEMORY_EXTRACTION_MIN_REPLY_LEN=40

# MCP (Model Context Protocol) tools server
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:9002
MCP_SERVER_TIMEOUT=30
MEMORY_EXTRACTION_MAX_ITEMS=5
# Conversation summaries for long-conversation recall
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_MODEL=
MEMORY_SUMMARY_TRIGGER_MESSAGES=20
MEMORY_SUMMARY_MAX_LENGTH=800

# Voice — Speech-to-Text / Text-to-Speech
# STT: groq (whisper-large-v3, free) or openai (whisper-1, paid)
# TTS: edge (free, no key) or elevenlabs (paid)
STT_PROVIDER=groq
TTS_PROVIDER=edge

# Email (Gmail example — use an App Password from your Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-gmail@gmail.com
EMAIL_FROM_NAME=Nova AI

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
